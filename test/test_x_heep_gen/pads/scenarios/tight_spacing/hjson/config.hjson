{
  // Tight spacing edge case - minimum allowable spacing
  "physical_attributes": {
    "floorplan_dimensions": { "width": 1200, "length": 1200 },
    "edge_offset": { "bondpad": 10, "pad": 50 },
    "spacing": { "bondpad": 15 },
    "dimensions": {
      "TIGHT_PAD": { "width": 35 }
    }
  },
  "pads": {
    "clk": {
      "num": 1,
      "type": "input",
      "mapping": "right",
      "layout_attributes": { "index": 0, "cell": "TIGHT_PAD", "orient": "r90", "bondpad": "TIGHT_PAD" }
    },
    "rst": {
      "num": 1,
      "active": "low",
      "type": "input",
      "mapping": "right",
      "layout_attributes": { "index": 1, "cell": "TIGHT_PAD", "orient": "r90", "bondpad": "TIGHT_PAD" }
    },
    "uart_rx": {
      "num": 1,
      "type": "input",
      "mapping": "right",
      "layout_attributes": { "index": 2, "cell": "TIGHT_PAD", "orient": "r90", "bondpad": "TIGHT_PAD" }
    },
    "uart_tx": {
      "num": 1,
      "type": "output",
      "mapping": "right",
      "layout_attributes": { "index": 3, "cell": "TIGHT_PAD", "orient": "r90", "bondpad": "TIGHT_PAD" }
    },
    "gpio": {
      "num": 12,
      "num_offset": 0,
      "type": "inout",
      "mapping": "left",
      "layout_attributes": { "index": 4, "cell": "TIGHT_PAD", "orient": "mx90", "bondpad": "TIGHT_PAD" }
    },
    "spi_sck": {
      "num": 1,
      "type": "inout",
      "mapping": "top",
      "layout_attributes": { "index": 5, "cell": "TIGHT_PAD", "orient": "r0", "bondpad": "TIGHT_PAD" }
    },
    "spi_mosi": {
      "num": 1,
      "type": "inout",
      "mapping": "top",
      "layout_attributes": { "index": 6, "cell": "TIGHT_PAD", "orient": "r0", "bondpad": "TIGHT_PAD" }
    },
    "spi_miso": {
      "num": 1,
      "type": "inout",
      "mapping": "bottom",
      "layout_attributes": { "index": 7, "cell": "TIGHT_PAD", "orient": "mx", "bondpad": "TIGHT_PAD" }
    },
    "spi_cs": {
      "num": 1,
      "type": "inout",
      "mapping": "bottom",
      "layout_attributes": { "index": 8, "cell": "TIGHT_PAD", "orient": "mx", "bondpad": "TIGHT_PAD" }
    }
  }
}
