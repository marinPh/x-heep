// X-HEEP configurations not yet supported by the Python modelling.
//
// WARNING! To be used together with a Python configuration. This does not
// contain all parameters required to configure X-HEEP.

{
    linker_script: {
        stack_size: 0x800
        heap_size: 0x800
    }

    debug: {
        address: 0x10000000
        length:  0x00100000
        has_spi_slave: "yes"
    }

    flash_mem: {
        address: 0x40000000
        length:  0x01000000
    }

    ext_slaves: {
        address: 0xF0000000
        length:  0x01000000
    }
}